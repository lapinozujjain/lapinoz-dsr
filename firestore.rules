rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return userDocExists() ? getUserData().get('role', '') : '';
    }

    function myIsActive() {
      return userDocExists() && getUserData().get('active', true) == true;
    }

    function isOwner() {
      return isSignedIn() && myIsActive() && (myRole() == 'owner' || myRole() == 'Owner');
    }

    function isOwnerOrManager() {
      return isSignedIn() && myIsActive() && (
        myRole() == 'owner' || myRole() == 'Owner' ||
        myRole() == 'manager' || myRole() == 'Manager'
      );
    }

    function isAnyActiveRole() {
      return isSignedIn() && myIsActive() && (
        myRole() in ['owner', 'manager', 'staff', 'Owner', 'Manager', 'Staff']
      );
    }

    // --- Team accounts (/users) ---
    match /users/{userId} {
      allow read: if isSignedIn();

      allow create: if isSignedIn() && (
        isOwner() ||
        (userId == request.auth.uid && (request.resource.data.role == 'owner' || request.resource.data.role == 'Owner') && !exists(/databases/$(database)/documents/app_config/meta))
      );

      allow update: if isOwner();
      allow delete: if isOwner() && userId != request.auth.uid;
    }

    // --- Bootstrap config lock ---
    match /app_config/{configId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && (isOwner() || !exists(/databases/$(database)/documents/app_config/meta));
      allow delete: if isOwner();
    }

    // --- DSR entries ---
    match /dsr_entries/{entryId} {
      allow read: if isAnyActiveRole();
      allow create: if isAnyActiveRole();
      allow update, delete: if isOwnerOrManager();
    }

    // --- Inventory master list ---
    match /inventory_master/{itemId} {
      allow read: if isAnyActiveRole();
      allow create, update: if isOwnerOrManager();
      allow delete: if isOwner();
    }

    // --- Daily inventory closing records ---
    match /inventory_daily_records/{recordId} {
      allow read: if isAnyActiveRole();
      allow create, update: if isAnyActiveRole();
      allow delete: if isOwner();
    }
  }
}